        <KeywordList>
          <Keyword>msg_fes_cth</Keyword>
          <Keyword>WCS</Keyword>
          <Keyword>ImageMosaic</Keyword>
        </KeywordList>
        <CRS>EPSG:4326</CRS>
        <CRS>CRS:84</CRS>
        <EX_GeographicBoundingBox>
